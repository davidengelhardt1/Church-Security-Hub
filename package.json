{
  "name": "church-security-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:alerts": "esbuild lib/alertFilter.ts --bundle --format=esm --platform=node --outfile=.test-build/alertFilter.mjs && node tests/alert-filter.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:safe": "esbuild lib/safe.ts --bundle --format=esm --platform=node --outfile=.test-build/safe.mjs && node tests/safe.test.mjs",
    "test": "npm run test:alerts && npm run test:safe"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "fast-xml-parser": "^5.11.2",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  }
}
