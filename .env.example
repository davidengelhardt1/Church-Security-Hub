# Optional. Without these, the dashboard still works - it just fetches live
# from GDELT/RSS on every page load instead of persisting history.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If set, /api/ingest requires this as a Bearer token.
# Vercel Cron sends this automatically if you set CRON_SECRET in your
# Vercel project's environment variables (Vercel adds the header for you).
CRON_SECRET=
